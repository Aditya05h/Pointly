{
  "name": "pointly",
  "version": "0.1.0",
  "description": "A focused desktop assistant for hands-free computer interaction.",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "start:server": "node server/index.js",
    "build": "electron-builder",
    "package": "electron-builder --dir"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "sarvamai": "^1.1.8-alpha.5"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pointly.desktop",
    "productName": "Pointly",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
