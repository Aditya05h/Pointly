{
  "name": "pointly",
  "version": "0.1.0",
  "description": "A focused desktop assistant for hands-free computer interaction.",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "start:server": "node server/index.js",
    "build": "electron-builder",
    "package": "electron-builder --dir"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pointly.desktop",
    "productName": "Pointly",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "win": { "target": "nsis" }
  }
}
